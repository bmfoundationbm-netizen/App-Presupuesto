{
  "name": "mi-presupuesto",
  "productName": "Mi Presupuesto",
  "version": "1.0.0",
  "description": "Presupuesto familiar de escritorio, estilo planilla: ingresos, gastos, imprevistos, ahorro, deudas e inversiones, con IPC por categoría, canasta básica y gráfico de Sankey.",
  "main": "electron/main.js",
  "private": true,
  "license": "MIT",
  "author": "bmfoundationbm-netizen",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"pruebas/**/*.test.mjs\"",
    "datos": "node tools/construir-datos.js",
    "engho": "node tools/procesar-engho.js",
    "dist": "electron-builder --win nsis portable --publish never"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.0",
    "d3": "^7.9.0",
    "d3-sankey": "^0.12.3",
    "exceljs": "^4.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "repository": "github:bmfoundationbm-netizen/App-Presupuesto",
  "homepage": "https://github.com/bmfoundationbm-netizen/App-Presupuesto",
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ar.bmfoundation.mipresupuesto",
    "productName": "Mi Presupuesto",
    "copyright": "Copyright © 2026 bmfoundationbm-netizen · licencia MIT",
    "files": [
      "electron/**/*",
      "web/**/*",
      "package.json",
      "LICENSE",
      "!web/**/*.map"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "fileAssociations": [
      {
        "ext": "presupuesto",
        "name": "Hogar de Mi Presupuesto",
        "description": "Hogar de Mi Presupuesto",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "Mi Presupuesto",
      "artifactName": "Mi-Presupuesto-${version}-instalador.${ext}",
      "uninstallDisplayName": "Mi Presupuesto"
    },
    "portable": {
      "artifactName": "Mi-Presupuesto-${version}-portable.${ext}"
    }
  }
}
